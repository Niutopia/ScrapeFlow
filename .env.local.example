# Copy this file to .env.local. The real file is ignored by Git.
ALIST_URL=http://127.0.0.1:5244
ALIST_USERNAME=admin
ALIST_PASSWORD=replace-with-your-alist-password
TMDB_API_KEY=replace-with-your-tmdb-api-key
TMDB_LANGUAGE=zh-CN
# Docker 持久化目录。已有部署必须继续使用原目录，否则会看到一套空状态。
SCRAPEFLOW_HOST_STATE_ROOT=/absolute/path/to/ScrapeFlow/state
# 媒体事务的恢复正文存放在夸克/AList 远端；本机只保留当前单文件缓冲。
# 每个批次先完整建立并回读校验恢复副本，严格作品验收后才清理。
SCRAPEFLOW_REMOTE_ROLLBACK_ROOT=/quark/影视/ScrapeFlow/事务回滚
# 只读扫描、TMDB 匹配和计划生成的并发数；可设 1–8，默认 4。
SCRAPEFLOW_ANALYSIS_WORKERS=4
# 路径互不重叠的复制、删除、解压任务并发数；可设 1–4，默认 1。
# 云存储写入保持低并发，不依赖 MOVE/rename 完成媒体事务。
SCRAPEFLOW_EXECUTION_WORKERS=2
# 计划通过引擎校验后自动进入冲突感知执行队列；同一作品路径仍严格串行。
SCRAPEFLOW_AUTO_EXECUTE_MEDIA=1
# 正常刮削成功后处理所有已发布缺集；Season 00 同样是必补缺口。
SCRAPEFLOW_AUTO_REPLENISH_MISSING=1
# 当前作品的必需来源暂时穷尽后，多久重新检查来源；不扫描其他作品。
# SCRAPEFLOW_SOURCE_REVIEW_INTERVAL=21600
# 查补适配器命令。协议为：
#   ADAPTER search --request REQUEST.json --output CANDIDATES.json
#   ADAPTER acquire --selection SELECTION.json --output ACQUISITION.json
# 内置 HTTP 桥接器示例（Docker 路径）：
# SCRAPEFLOW_REPLENISHMENT_ADAPTER=python3 /app/engine/tools/replenishment_http_adapter.py
# SCRAPEFLOW_REPLENISHMENT_SEARCH_URL=https://HOST/api/search
# SCRAPEFLOW_REPLENISHMENT_ACQUIRE_URL=https://HOST/api/acquire
# SCRAPEFLOW_REPLENISHMENT_STATUS_URL=https://HOST/api/acquire/status
# SCRAPEFLOW_REPLENISHMENT_ACQUIRE_TIMEOUT=21600
# SCRAPEFLOW_REPLENISHMENT_POLL_INTERVAL=10
# SCRAPEFLOW_REPLENISHMENT_TOKEN=replace-with-provider-adapter-token
# Local adapter with optional, explicitly supplied verified inputs:
# SCRAPEFLOW_REPLENISHMENT_ADAPTER=python3 /app/engine/tools/replenishment_local_adapter.py
# SCRAPEFLOW_REPLENISHMENT_CATALOG=/data/operator-inputs/replenishment-catalog.json
# 可选：经人工或独立流程核验的只读夸克分享索引；搜索只读取，不执行转存。
# SCRAPEFLOW_REPLENISHMENT_QUARK_INDEX=/data/operator-inputs/quark-share-index.json
# 可选：动态发现夸克公开分享。结果仍会经夸克只读递归清单、精确集号、
# file_id/path/size 校验后才形成一级快转候选，搜索标题本身不构成准入证据。
# SCRAPEFLOW_REPLENISHMENT_PANSOU_URL=https://s.panhunt.com/api/search
# SCRAPEFLOW_REPLENISHMENT_PANSOU_MAX_SHARES=30
# SCRAPEFLOW_REPLENISHMENT_ANIMETOSHO_SEARCH=1
# SCRAPEFLOW_REPLENISHMENT_SUBSPLEASE_SEARCH=1
# SCRAPEFLOW_REPLENISHMENT_TOKYOTOSHO_SEARCH=1
# SCRAPEFLOW_REPLENISHMENT_TOKYOTOSHO_URL=https://tokyo-tosho.net
# SCRAPEFLOW_REPLENISHMENT_SEARCH_WORKERS=2
# SCRAPEFLOW_REPLENISHMENT_SHARE_SEARCH_TIMEOUT=120
# SCRAPEFLOW_REPLENISHMENT_DOWNLOAD_DIR=/var/tmp/scrapeflow/replenishment
# SCRAPEFLOW_REPLENISHMENT_UNSCRAPED_ROOT=/quark/影视/ScrapeFlow/补源
# SCRAPEFLOW_REPLENISHMENT_BT_IDLE_TIMEOUT=600
# SCRAPEFLOW_REPLENISHMENT_TORRENT_TIMEOUT=21600
# 云存储上传返回后等待 AList 刷新列表可见的最长时间。
# SCRAPEFLOW_REPLENISHMENT_ARRIVAL_TIMEOUT=120
# 宿主机 Quark Native Helper；它在夸克原生 renderer 中完成 WSG，API 无需 Codex/网页点击。
# Docker Desktop/Linux Compose 使用 host.docker.internal；仅 Helper 已常驻后开启。
# SCRAPEFLOW_QUARK_HELPER_URL=http://host.docker.internal:18765
# SCRAPEFLOW_QUARK_HELPER_TOKEN=replace-with-at-least-24-random-characters
# SCRAPEFLOW_QUARK_HELPER_TIMEOUT=120
# 云离线基础设施/进度故障只原地自愈，不计资源尝试，也绝不解锁本地 Torrent。
# SCRAPEFLOW_REPLENISHMENT_OFFLINE_RECOVERY_ATTEMPTS=3
# SCRAPEFLOW_REPLENISHMENT_OFFLINE_RECOVERY_DELAY=5
# 启用内置 Mikan + SubsPlease + Nyaa RSS + TokyoTosho + AnimeTosho + ACG.RIP 检索。
# SCRAPEFLOW_REPLENISHMENT_ACG_SEARCH=1
# SCRAPEFLOW_REPLENISHMENT_MIKAN_SEARCH=1
# SCRAPEFLOW_REPLENISHMENT_DMHY_SEARCH=1
# ACG.RIP 在部分网络需要宿主机代理；仅代理该搜索源，不代理 Quark/AList。
# 宿主机本地运行示例：
# SCRAPEFLOW_REPLENISHMENT_ACG_PROXY=http://127.0.0.1:7897
# Docker 中如需代理，必须显式填写可从容器访问的地址：
# SCRAPEFLOW_REPLENISHMENT_ACG_PROXY_DOCKER=http://host.docker.internal:7897
# SCRAPEFLOW_REPLENISHMENT_DYNAMIC_SEARCH_TIMEOUT=45
# 同一作品最多执行多少轮“获取 → 刮削 → 再检测”；0 表示持续自动重试直到作品闭环。
SCRAPEFLOW_REPLENISHMENT_MAX_ROUNDS=0
# 一级分享、二级夸克磁力各至少完成 30 次有效资源级尝试才可进级。
SCRAPEFLOW_REPLENISHMENT_MIN_CLOUD_ATTEMPTS=30
# 自动重试基础等待秒数；连续失败会做有上限的退避。
SCRAPEFLOW_REPLENISHMENT_RETRY_DELAY=30
# 仅在默认 TMDB 域名不可达时，填写你信任的 HTTPS API 地址。
# TMDB_BASE_URL=https://api.themoviedb.org/3
# Docker 默认使用 TMDB 官方 API；只有明确需要其他端点时才覆盖。
# TMDB_BASE_URL_DOCKER=https://api.themoviedb.org/3
# TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/original
# Optional credential-free HTTP proxy used only by TMDB API/image requests.
# TMDB_PROXY_URL=http://127.0.0.1:7897
# TMDB_PROXY_URL_DOCKER=http://host.docker.internal:7897

# Docker Compose 内部固定通过 http://alist:5244 访问随项目运行的 AList。
# ALIST_URL 仅用于 npm run local 等非 Docker 模式。
# Web 端口默认 3010；可在 .env.local 中设置 SCRAPEFLOW_PORT=8080。
# Use TMDB's alternate official API hostname when the primary hostname is not
# reachable from the host or Docker network.
TMDB_BASE_URL=https://api.tmdb.org/3
TMDB_BASE_URL_DOCKER=https://api.tmdb.org/3
