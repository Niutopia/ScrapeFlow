# Copy this file to .env.local. The real file is ignored by Git.

# AList and TMDB credentials.
ALIST_URL=http://127.0.0.1:5244
ALIST_USERNAME=admin
ALIST_PASSWORD=replace-with-your-alist-password
TMDB_API_KEY=replace-with-your-tmdb-api-key
TMDB_LANGUAGE=zh-CN

# Compose persists local state under this host directory.
SCRAPEFLOW_HOST_STATE_ROOT=/absolute/path/to/ScrapeFlow/state

# The Quark Helper is local to the Compose stack. Keep its token private: it
# is redacted from API responses and logs.
SCRAPEFLOW_QUARK_HELPER_URL=http://127.0.0.1:18765
SCRAPEFLOW_QUARK_HELPER_TOKEN=replace-with-a-random-helper-token-at-least-24-characters

# First-tier Quark-share discovery. Leave disabled until a reachable PanSou
# service and a logged-in Quark storage are available.
SCRAPEFLOW_PANSOU_ENABLED=0
SCRAPEFLOW_PANSOU_URL=
SCRAPEFLOW_PANSOU_TOKEN=
SCRAPEFLOW_PANSOU_TIMEOUT=12
SCRAPEFLOW_PANSOU_MAX_QUERIES=4
SCRAPEFLOW_PANSOU_MAX_LINKS=64

# Formal-library payload floor. Values below 64 KiB are clamped.
SCRAPEFLOW_MIN_VIDEO_BYTES=1048576

# Bounded archive/container staging. Ordinary compressed archives retain the
# smaller defaults; optical images have independent ceilings so one 45–50 GiB
# disc can be inspected/extracted only when `/data` has room for its staged
# input, selected members and this reserve. Do not set these to zero.
# SCRAPEFLOW_ARCHIVE_MIN_FREE_BYTES=2147483648
# SCRAPEFLOW_DISC_IMAGE_MAX_SOURCE_BYTES=68719476736
# SCRAPEFLOW_DISC_IMAGE_MAX_EXPANDED_BYTES=68719476736
# SCRAPEFLOW_DISC_IMAGE_MAX_MEMBER_BYTES=68719476736
# SCRAPEFLOW_DISC_IMAGE_MAX_EXPANSION_RATIO=4
# SCRAPEFLOW_DISC_IMAGE_COMMAND_TIMEOUT_SECONDS=5400

# Subtitle acquisition stays opt-in.
SCRAPEFLOW_REQUIRED_SUBTITLE_LANGUAGE=zh
# SCRAPEFLOW_SUBTITLE_PROVIDER_ENABLED=1
# SCRAPEFLOW_OPENSUBTITLES_API_KEY=

# Optional endpoint and proxy overrides. BT downloads always clear proxy
# variables and use direct network access.
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_BASE_URL_DOCKER=https://api.themoviedb.org/3
# TMDB_PROXY_URL=http://127.0.0.1:7897
# TMDB_PROXY_URL_DOCKER=http://host.docker.internal:7897
# SCRAPEFLOW_HTTP_PROXY=http://host.docker.internal:7897
# SCRAPEFLOW_HTTPS_PROXY=http://host.docker.internal:7897

# Enable only search sources reachable in this installation.
# SCRAPEFLOW_REPLENISHMENT_ANIMETOSHO_SEARCH=1
# SCRAPEFLOW_REPLENISHMENT_TOKYOTOSHO_SEARCH=1
# SCRAPEFLOW_REPLENISHMENT_SUBSPLEASE_SEARCH=1
# SCRAPEFLOW_REPLENISHMENT_MIKAN_SEARCH=1
# SCRAPEFLOW_REPLENISHMENT_DMHY_SEARCH=1
# SCRAPEFLOW_REPLENISHMENT_NYAA_SEARCH=0
# SCRAPEFLOW_REPLENISHMENT_DYNAMIC_SEARCH_TIMEOUT=45
# SCRAPEFLOW_REPLENISHMENT_ACG_SEARCH=0
SCRAPEFLOW_REPLENISHMENT_BT_IDLE_TIMEOUT=120
SCRAPEFLOW_REPLENISHMENT_TORRENT_TIMEOUT=900
