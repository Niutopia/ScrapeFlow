# Copy this file to .env.local. The real file is ignored by Git.

# AList and TMDB credentials.
ALIST_URL=http://127.0.0.1:5244
ALIST_USERNAME=admin
ALIST_PASSWORD=replace-with-your-alist-password
TMDB_API_KEY=replace-with-your-tmdb-api-key
TMDB_LANGUAGE=zh-CN

# Compose persists API state under this host directory.
SCRAPEFLOW_HOST_STATE_ROOT=/absolute/path/to/ScrapeFlow/state

# Media-library and scheduler defaults.
SCRAPEFLOW_MEDIA_ROOT=/quark/影视
SCRAPEFLOW_INTAKE_MONITOR=1
SCRAPEFLOW_INTAKE_SCAN_SECONDS=30
SCRAPEFLOW_AUTOMATIC_AUDIT=1

# Automatic retries and provider concurrency.
SCRAPEFLOW_AUTOMATIC_RETRY_LIMIT=3
SCRAPEFLOW_PROVIDER_RETRY_LIMIT=5
SCRAPEFLOW_PROVIDER_WORKERS=3
# Formal-library video admission floor (default 1 MiB; values below 64 KiB
# are clamped to the immutable safety floor).
# SCRAPEFLOW_MIN_VIDEO_BYTES=1048576
# Optional deterministic provider pilot. While set, only the matching TMDB
# root may start provider work; all other audited gaps remain queued.
# SCRAPEFLOW_PROVIDER_PILOT_TMDB=79166
# 可选：在一个多缺口作品中只验证一条明确季集；必须与 TMDB selector 同用。
# SCRAPEFLOW_PROVIDER_PILOT_GAP=S03E05
# Concurrent TMDB catalog reads during a full-library audit (1–4, default 4).
# SCRAPEFLOW_TMDB_AUDIT_WORKERS=4
# Embedded-subtitle evidence is bounded per full-library audit.  At the
# deadline unresolved probes stay unknown (fail closed) and are retried by a
# later audit; sidecars and complete Matroska Tracks prefixes remain immediate.
# SCRAPEFLOW_SUBTITLE_PROBE_BUDGET_SECONDS=120
# SCRAPEFLOW_SUBTITLE_PROBE_WORKERS=4
# SCRAPEFLOW_SUBTITLE_PROBE_MAX_FILES=2048
SCRAPEFLOW_REQUIRED_SUBTITLE_LANGUAGE=zh

# Optional TMDB endpoint/proxy overrides. Keep credentials out of URLs.
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_BASE_URL_DOCKER=https://api.themoviedb.org/3
# TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/original
# TMDB_PROXY_URL=http://127.0.0.1:7897
# TMDB_PROXY_URL_DOCKER=http://host.docker.internal:7897

# Optional HTTP provider proxy. Keep AList on the compose network via NO_PROXY.
# HTTP_PROXY=http://host.docker.internal:7897
# HTTPS_PROXY=http://host.docker.internal:7897
# NO_PROXY=alist,localhost,127.0.0.1
# Enable only provider lanes that are reachable in the current deployment.
# SCRAPEFLOW_REPLENISHMENT_ANIMETOSHO_SEARCH=1
# SCRAPEFLOW_REPLENISHMENT_TOKYOTOSHO_SEARCH=1
# SCRAPEFLOW_REPLENISHMENT_SUBSPLEASE_SEARCH=1
# SCRAPEFLOW_REPLENISHMENT_MIKAN_SEARCH=1
# SCRAPEFLOW_REPLENISHMENT_DMHY_SEARCH=1
# SCRAPEFLOW_REPLENISHMENT_NYAA_SEARCH=0
# SCRAPEFLOW_REPLENISHMENT_ACG_SEARCH=0
# Bound a pilot's torrent wait; lower values fail closed and let the next
# candidate round try another verified release.
# SCRAPEFLOW_REPLENISHMENT_BT_IDLE_TIMEOUT=120
# SCRAPEFLOW_REPLENISHMENT_TORRENT_TIMEOUT=900

# Web port on the loopback interface (default 3010).
# SCRAPEFLOW_PORT=3010
