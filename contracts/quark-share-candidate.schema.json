{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrapeflow.local/contracts/quark-share-candidate.schema.json",
  "title": "ScrapeFlow Quark share replenishment candidate",
  "type": "object",
  "required": ["provider", "locator", "share_identity", "files", "file_coverage", "acquisition"],
  "properties": {
    "provider": {"const": "quark_share"},
    "locator": {"type": "string", "pattern": "^quark_share:[A-Za-z0-9_-]+$"},
    "share_identity": {
      "type": "object",
      "required": ["provider", "share_id"],
      "properties": {
        "provider": {"const": "quark"},
        "share_id": {"type": "string", "minLength": 1}
      }
    },
    "files": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "file_coverage": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]{2}E[0-9]{2,3}$"}, "minItems": 1},
    "payload_kind": {"enum": ["video_payload", "archive_payload"]},
    "requires_extraction": {"type": "boolean"},
    "archive_format": {"type": ["string", "null"]},
    "video_files_verified": {"type": "boolean"},
    "acquisition": {
      "type": "object",
      "required": ["kind", "share_id", "share_url", "file_id_by_gap", "file_path_by_id", "file_size_by_id", "save_strategy", "requires_share_revalidation"],
      "properties": {
        "kind": {"enum": ["quark_fast_save", "quark_sfx_archive"]},
        "share_id": {"type": "string", "minLength": 1},
        "share_url": {"type": "string", "pattern": "^https://pan\\.quark\\.cn/s/[A-Za-z0-9_-]+$"},
        "file_id_by_gap": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}, "minItems": 1}},
        "file_path_by_id": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "file_size_by_id": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "save_strategy": {"const": "server_side_copy"},
        "requires_share_revalidation": {"const": true},
        "payload_kind": {"enum": ["video_payload", "archive_payload"]},
        "requires_extraction": {"type": "boolean"},
        "archive_format": {"type": ["string", "null"]},
        "expected_archives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file_id", "name", "path", "size", "gap_ids"],
            "properties": {
              "file_id": {"type": "string", "minLength": 1},
              "name": {"type": "string", "pattern": "(?i)\\.exe$"},
              "path": {"type": "string", "minLength": 1},
              "size": {"type": "integer", "minimum": 1},
              "gap_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}
            }
          }
        },
        "archive_member_by_gap": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "archive_member_size_by_gap": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"payload_kind": {"const": "archive_payload"}}, "required": ["payload_kind"]},
    "then": {
      "required": ["requires_extraction", "archive_format", "video_files_verified"],
      "properties": {
        "requires_extraction": {"const": true},
        "archive_format": {"const": "sfx"},
        "video_files_verified": {"const": false},
        "acquisition": {
          "required": ["payload_kind", "requires_extraction", "archive_format", "expected_archives", "archive_member_by_gap", "archive_member_size_by_gap"],
          "properties": {
            "kind": {"const": "quark_sfx_archive"},
            "payload_kind": {"const": "archive_payload"},
            "requires_extraction": {"const": true},
            "archive_format": {"const": "sfx"},
            "expected_archives": {"minItems": 1}
          }
        }
      }
    }
  }],
  "additionalProperties": true
}
