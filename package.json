{
  "name": "scrapeflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "local": "node scripts/local.mjs",
    "dev": "next dev",
    "build": "next build",
    "build:check": "node scripts/build-web-staging.mjs",
    "test": "node scripts/check.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "node scripts/check.mjs",
    "docker:up": "docker compose --env-file .env.local up --build -d",
    "docker:down": "docker compose --env-file .env.local down"
  },
  "dependencies": {
    "next": "^16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.8.0",
    "globals": "17.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.20"
    },
    "sharp": "0.35.3"
  },
  "type": "module"
}
