FROM python:3.12-slim-bookworm

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# The API process owns intake, planning, library writes, audit and acquisition.
# aria2c downloads selected torrents; ffprobe checks downloaded media streams.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        aria2 \
        ffmpeg \
        tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /data/jobs /var/tmp/scrapeflow

COPY engine ./engine
COPY local ./local

EXPOSE 8765
CMD ["python3", "-m", "local.simple_server"]
